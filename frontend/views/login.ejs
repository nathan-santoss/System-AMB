<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <%- include('partials/head') %>

        <title>
            Login - Sistema de Ambulatório
        </title>

</head>

<body class="min-h-screen bg-slate-100 flex items-center justify-center p-4">

    <main class="w-full max-w-md">

        <section class="bg-white rounded-3xl shadow-xl border border-slate-100 overflow-hidden"
            aria-labelledby="titulo-login">

            <div class="bg-azulEscuro px-8 py-9 text-center">

                <div class="w-20 h-20 mx-auto bg-white/10 rounded-2xl flex items-center justify-center shadow-inner"
                    aria-hidden="true">

                    <i data-lucide="shield-plus" class="text-white w-11 h-11">
                    </i>

                </div>

                <h1 class="text-2xl font-bold text-white mt-5">

                    Nexa Logos

                </h1>

                <p class="text-sm text-blue-200 mt-1">

                    Sistema Ambulatorial Integrado

                </p>

            </div>

            <div class="p-6 sm:p-8">

                <div class="mb-7">

                    <h2 id="titulo-login" class="text-xl font-bold text-slate-800">

                        Acesse o sistema

                    </h2>

                    <p class="text-sm text-slate-500 mt-1">

                        Informe suas credenciais para continuar.

                    </p>

                </div>

                <div id="mensagem-login" class="hidden mb-5 rounded-xl border px-4 py-3 text-sm" role="alert"
                    aria-live="polite" aria-atomic="true">
                </div>

                <form id="loginForm" class="space-y-5" novalidate>

                    <div>

                        <label for="email" class="block text-sm font-semibold text-slate-700 mb-1.5">

                            E-mail corporativo

                        </label>

                        <div class="relative">

                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
                                aria-hidden="true">

                                <i data-lucide="mail" class="h-5 w-5 text-slate-400">
                                </i>

                            </div>

                            <input type="email" id="email" name="email" maxlength="150" autocomplete="email"
                                inputmode="email" required placeholder="usuario@empresa.com"
                                class="w-full pl-12 pr-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-azulEscuro focus:border-transparent transition-all">

                        </div>

                    </div>

                    <div>

                        <label for="senha" class="block text-sm font-semibold text-slate-700 mb-1.5">

                            Senha

                        </label>

                        <div class="relative">

                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
                                aria-hidden="true">

                                <i data-lucide="lock-keyhole" class="h-5 w-5 text-slate-400">
                                </i>

                            </div>

                            <input type="password" id="senha" name="senha" minlength="8" maxlength="255"
                                autocomplete="current-password" required placeholder="Digite sua senha"
                                class="w-full pl-12 pr-12 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-azulEscuro focus:border-transparent transition-all">

                            <button type="button" id="botao-alternar-senha"
                                class="absolute inset-y-0 right-0 px-4 flex items-center justify-center text-slate-400 hover:text-azulEscuro transition-colors"
                                aria-label="Mostrar senha" title="Mostrar senha">

                                <i data-lucide="eye" class="h-5 w-5">
                                </i>

                            </button>

                        </div>

                    </div>

                    <button type="submit" id="botao-entrar"
                        class="w-full bg-azulEscuro hover:bg-blue-800 text-white font-bold py-3.5 px-5 rounded-xl shadow-md transition-all flex items-center justify-center gap-2">

                        <span>
                            Entrar no sistema
                        </span>

                        <i data-lucide="log-in" class="w-5 h-5" aria-hidden="true">
                        </i>

                    </button>

                </form>

                <div class="mt-7 rounded-xl bg-blue-50 border border-blue-100 p-4">

                    <div class="flex items-start gap-3">

                        <i data-lucide="info" class="w-5 h-5 text-blue-700 shrink-0 mt-0.5" aria-hidden="true">
                        </i>

                        <p class="text-xs leading-relaxed text-blue-800">

                            Utilize apenas credenciais autorizadas. Caso não possua acesso, procure o responsável pela
                            administração do sistema.

                        </p>

                    </div>

                </div>

            </div>

        </section>

        <p class="text-center text-xs text-slate-400 mt-5">

            Sistema de gerenciamento ambulatorial

        </p>

    </main>

    <script src="/js/auth-session.js"></script>
    <script src="/js/login.js"></script>

</body>

</html>