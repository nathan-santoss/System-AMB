<div
    id="sidebar-backdrop"
    class="fixed inset-0 z-40 hidden bg-black/60 backdrop-blur-sm md:hidden"
    aria-hidden="true"
></div>

<aside
    id="sidebar-principal"
    class="fixed inset-y-0 left-0 z-50 flex h-screen w-72 -translate-x-full flex-col bg-azulEscuro text-white shadow-2xl transition-transform duration-200 md:sticky md:top-0 md:z-auto md:w-64 md:translate-x-0"
    aria-label="Menu principal"
>
    <div class="flex items-center justify-between border-b border-blue-800/60 p-6">
        <a href="/dashboard" class="flex items-center gap-3" aria-label="Ir para o dashboard">
            <div
                class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/10"
                aria-hidden="true"
            >
                <i data-lucide="shield-plus" class="h-7 w-7"> </i>
            </div>

            <div>
                <span class="block text-xl font-bold tracking-wide"> Nexa Logos </span>

                <span class="block text-xs text-blue-200"> Sistema Ambulatorial </span>
            </div>
        </a>

        <button
            type="button"
            id="botao-fechar-sidebar"
            class="flex h-10 w-10 items-center justify-center rounded-lg text-blue-200 transition-all hover:bg-white/10 hover:text-white md:hidden"
            aria-label="Fechar menu"
            aria-controls="sidebar-principal"
        >
            <i data-lucide="x" class="h-5 w-5" aria-hidden="true"> </i>
        </button>
    </div>

    <nav class="flex-1 space-y-2 overflow-y-auto p-4">
        <p class="mb-3 px-4 text-xs font-bold uppercase tracking-wider text-blue-300">Navegação</p>

        <a
            href="/dashboard"
            data-menu="dashboard"
            class="item-menu-sidebar flex items-center gap-3 rounded-xl px-4 py-3 font-medium text-blue-100 transition-all hover:bg-blue-800/60 hover:text-white"
        >
            <i data-lucide="layout-dashboard" class="h-5 w-5 shrink-0" aria-hidden="true"> </i>

            <span> Dashboard </span>
        </a>

        <a
            href="/consultar-paciente"
            data-menu="funcionarios"
            class="item-menu-sidebar flex items-center gap-3 rounded-xl px-4 py-3 font-medium text-blue-100 transition-all hover:bg-blue-800/60 hover:text-white"
        >
            <i data-lucide="users" class="h-5 w-5 shrink-0" aria-hidden="true"> </i>

            <span> Funcionários </span>
        </a>

        <a
            href="/novo-atendimento"
            data-menu="novo-atendimento"
            class="item-menu-sidebar flex items-center gap-3 rounded-xl px-4 py-3 font-medium text-blue-100 hover:bg-blue-800/60"
            ><i data-lucide="circle-plus" class="h-5 w-5"></i><span>Novo atendimento</span></a
        >
        <a
            href="/atendimentos"
            data-menu="atendimentos"
            class="item-menu-sidebar flex items-center gap-3 rounded-xl px-4 py-3 font-medium text-blue-100 hover:bg-blue-800/60"
            ><i data-lucide="clipboard-list" class="h-5 w-5"></i><span>Atendimentos</span></a
        >
        <a
            href="/relatorios"
            data-menu="relatorios"
            class="item-menu-sidebar flex items-center gap-3 rounded-xl px-4 py-3 font-medium text-blue-100 hover:bg-blue-800/60"
            ><i data-lucide="chart-no-axes-combined" class="h-5 w-5"></i><span>Relatórios</span></a
        >
        <div class="my-4 border-t border-blue-800/60"></div>

        <div class="rounded-xl border border-blue-700/50 bg-blue-900/30 p-4">
            <div class="flex items-start gap-3">
                <i
                    data-lucide="heart-pulse"
                    class="mt-0.5 h-5 w-5 shrink-0 text-blue-200"
                    aria-hidden="true"
                >
                </i>

                <div>
                    <p class="text-sm font-semibold text-white">Ambulatório</p>

                    <p class="mt-1 text-xs leading-relaxed text-blue-200">
                        Gerencie funcionários, alergias e atendimentos ambulatoriais.
                    </p>
                </div>
            </div>
        </div>
    </nav>

    <div class="border-t border-blue-800/60 p-4">
        <button
            type="button"
            id="botao-logout-sidebar"
            class="flex w-full items-center gap-3 rounded-xl px-4 py-3 font-semibold text-red-300 transition-all hover:bg-red-500/20 hover:text-red-200 disabled:cursor-not-allowed disabled:opacity-70"
        >
            <i data-lucide="log-out" class="h-5 w-5" aria-hidden="true"> </i>

            <span id="texto-logout-sidebar"> Sair do sistema </span>
        </button>
    </div>
</aside>

<button
    type="button"
    id="botao-abrir-sidebar"
    class="fixed bottom-5 right-5 z-30 flex h-14 w-14 items-center justify-center rounded-full bg-azulEscuro text-white shadow-xl transition-all hover:bg-blue-800 md:hidden"
    aria-label="Abrir menu"
    aria-controls="sidebar-principal"
    aria-expanded="false"
>
    <i data-lucide="menu" class="h-6 w-6" aria-hidden="true"> </i>
</button>

<script src="/js/sidebar.js" defer></script>
