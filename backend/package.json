{
  "name": "system-amb",
  "version": "1.1.0",
  "description": "Sistema de gerenciamento ambulatorial",
  "homepage": "https://github.com/nathan-santoss/System-AMB#readme",
  "bugs": {
    "url": "https://github.com/nathan-santoss/System-AMB/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathan-santoss/System-AMB.git"
  },
  "license": "ISC",
  "author": "nathan-santos",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "check:backend": "node scripts/check-syntax.js server.js app.js src scripts",
    "check:frontend": "node scripts/check-syntax.js ../frontend/public/js",
    "check": "npm run check:backend && npm run check:frontend && npm run check:views",
    "build:css": "tailwindcss -i ../frontend/styles/base.css -o ../frontend/public/styles/tailwind.css --minify",
    "format": "prettier --write \"src/**/*.js\" server.js app.js \"../frontend/public/js/*.js\" \"../frontend/public/styles/!(tailwind).css\" \"../frontend/styles/*.css\"",
    "check:views": "node scripts/check-syntax.js ../frontend/views"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.3",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.17"
  }
}
