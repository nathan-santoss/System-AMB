# Ambiente
NODE_ENV=development
PORT=3000

# Banco por configuração manual
DB_NAME=db_ambulatorio
DB_USER=usuario_da_aplicacao
DB_PASS=troque_por_uma_senha_segura
DB_HOST=localhost
DB_PORT=3306

# Se MYSQL_URL ou DATABASE_URL estiver preenchida, ela terá prioridade
# sobre as variáveis DB_* acima.
MYSQL_URL=
DATABASE_URL=
MYSQL_PUBLIC_URL=

# Use uma chave aleatória com pelo menos 32 caracteres.
JWT_SECRET=troque_por_uma_chave_aleatoria_com_mais_de_32_caracteres

# Usuários autorizados a cadastrar novos acessos.
# Separe vários e-mails por vírgula.
ADMIN_EMAILS=admin@empresa.com

# Criação opcional do primeiro usuário administrativo.
# O usuário só será criado se ainda não existir.
# A senha nunca será redefinida automaticamente.
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.com
BOOTSTRAP_ADMIN_PASSWORD=troque_por_uma_senha_forte_com_12_caracteres_ou_mais