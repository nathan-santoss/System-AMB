# Ambiente
NODE_ENV=development
PORT=3000
# Se houver proxy reverso, informe somente seus IPs/sub-redes confiáveis, separados por vírgula.
TRUST_PROXY=

# PostgreSQL: informe a URL completa do banco.
DATABASE_URL=postgres://usuario_da_aplicacao:troque_por_uma_senha_segura@localhost:5432/db_ambulatorio
# Use true no banco remoto (incluindo Neon), com certificado válido.
# false é destinado ao PostgreSQL local sem TLS.
DATABASE_SSL=false

# Use uma chave aleatória com pelo menos 32 caracteres.
JWT_SECRET=troque_por_uma_chave_aleatoria_com_mais_de_32_caracteres

# Criação opcional do primeiro usuário administrativo.
# O usuário só será criado se ainda não existir.
# A senha nunca será redefinida automaticamente.
# A senha deve ter pelo menos 12 caracteres e no máximo 72 bytes em UTF-8.
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.com
BOOTSTRAP_ADMIN_PASSWORD=troque_por_uma_senha_forte_com_12_caracteres_ou_mais
